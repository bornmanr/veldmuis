verify() {
  cd "${_source_root}"
  printf '%s\n' "${_payload_sha256sums[@]}" | sha256sum --check --quiet
}

package() {
  install -Dm644 "${srcdir}/rat1.png" \
    "${pkgdir}/usr/share/veldmuis/wallpapers/rat1.png"
  install -Dm644 "${srcdir}/kdeglobals" \
    "${pkgdir}/etc/xdg/kdeglobals"
  install -Dm644 "${srcdir}/kwalletrc" \
    "${pkgdir}/etc/xdg/kwalletrc"
  install -Dm644 "${srcdir}/gwenviewrc" \
    "${pkgdir}/etc/xdg/gwenviewrc"
  install -Dm644 "${srcdir}/kscreenlockerrc" \
    "${pkgdir}/etc/xdg/kscreenlockerrc"
  install -Dm755 "${_source_root}/migration/veldmuis-apply-branding.sh" \
    "${pkgdir}/usr/bin/veldmuis-apply-branding"
  install -Dm644 "${_source_root}/migration/veldmuis-branding-once.desktop" \
    "${pkgdir}/etc/xdg/autostart/veldmuis-branding-once.desktop"
  install -Dm644 "${_source_root}/colors/Veldmuis.colors" \
    "${pkgdir}/usr/share/color-schemes/Veldmuis.colors"
  install -Dm644 "${_source_root}/gtk/settings-3.0.ini" \
    "${pkgdir}/etc/xdg/gtk-3.0/settings.ini"
  install -Dm644 "${_source_root}/gtk/settings-4.0.ini" \
    "${pkgdir}/etc/xdg/gtk-4.0/settings.ini"
  install -Dm644 "${_source_root}/gtk/theme/index.theme" \
    "${pkgdir}/usr/share/themes/Veldmuis/index.theme"
  install -Dm644 "${_source_root}/gtk/theme/gtk-3.0/gtk.css" \
    "${pkgdir}/usr/share/themes/Veldmuis/gtk-3.0/gtk.css"
  install -Dm644 "${_source_root}/gtk/theme/gtk-4.0/gtk.css" \
    "${pkgdir}/usr/share/themes/Veldmuis/gtk-4.0/gtk.css"
  install -Dm644 "${_source_root}/plasma-theme/metadata.json" \
    "${pkgdir}/usr/share/plasma/desktoptheme/Veldmuis/metadata.json"
  install -Dm644 "${_source_root}/plasma-theme/colors" \
    "${pkgdir}/usr/share/plasma/desktoptheme/Veldmuis/colors"
  install -Dm644 "${_source_root}/plasma-theme/plasmarc" \
    "${pkgdir}/usr/share/plasma/desktoptheme/Veldmuis/plasmarc"
  install -Dm644 "${_source_root}/veldmuis-wallpaper/metadata.json" \
    "${pkgdir}/usr/share/wallpapers/VeldmuisDawn/metadata.json"
  install -Dm644 "${_source_root}/veldmuis-wallpaper/contents/images/1920x1080.png" \
    "${pkgdir}/usr/share/wallpapers/VeldmuisDawn/contents/images/1920x1080.png"
  install -Dm644 "${_source_root}/veldmuis-wallpaper/contents/screenshot.png" \
    "${pkgdir}/usr/share/wallpapers/VeldmuisDawn/contents/screenshot.png"
  install -Dm644 "${_source_root}/org.veldmuis.desktop/metadata.json" \
    "${pkgdir}/usr/share/plasma/look-and-feel/org.veldmuis.desktop/metadata.json"
  install -Dm644 "${_source_root}/org.veldmuis.desktop/contents/defaults" \
    "${pkgdir}/usr/share/plasma/look-and-feel/org.veldmuis.desktop/contents/defaults"
  install -Dm644 "${_source_root}/org.veldmuis.desktop/contents/layouts/org.kde.plasma.desktop-layout.js" \
